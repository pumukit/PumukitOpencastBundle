{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}
    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">{% trans %}Opencast Importer{% endtrans %}</li>
        </ul>
    </h3>

    <div class="row">
        <div class="col-md-10">
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">{% trans %}ERROR{% endtrans %}</h4>
                {% if type == 'unsupported' %}
                    <p>{% trans %}This version of Opencast is not supported.{% endtrans %} ({{ version }})</p>
                {% endif %}
                <p class="mb-0">{{ message }}</p>
            </div>

            {% if type == 'connection' %}
                <div class="card">
                    <div class="card-header">Debug</div>
                    <div class="card-body">
                        {% trans %}Execute on the server{% endtrans %}:
                        <pre class="mt-2">php bin/console pumukit:opencast:check</pre>
                        <pre>curl -m {{ constant('Pumukit\\OpencastBundle\\Client\\OpencastHttpClient::TIMEOUT') }} --connect-timeout {{ constant('Pumukit\\OpencastBundle\\Client\\OpencastHttpClient::CONNECT_TIMEOUT') }} -v --digest -u %USER%:%PASSWORD% -H "X-Requested-Auth: Digest" {{ host }}/info/health</pre>
                        <ul class="mb-0">
                            <li><code>%USER%</code>: org.opencastproject.security.digest.user</li>
                            <li><code>%PASSWORD%</code>: org.opencastproject.security.digest.pass</li>
                        </ul>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
