<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}opencast track info{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{% trans %}Close{% endtrans %}"></button>
</div>
<div class="modal-body">
    <dl class="row">
        <dt class="col-sm-3">Opencast</dt>
        <dd class="col-sm-9">{{ mm.getProperty('opencast') }}</dd>
        {% for label, track in {'Presenter': presenter, 'Presentation': presentation} %}
            <dt class="col-sm-3">{{ label|trans }}</dt>
            <dd class="col-sm-9">
                {% if track %}
                    <input type="text" class="form-control" readonly value="{{ track.storage().url().url() }}" aria-label="{{ label|trans }}">
                {% else %}
                    -
                {% endif %}
            </dd>
        {% endfor %}
    </dl>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-pumukit" data-bs-dismiss="modal">{% trans %}OK{% endtrans %}</button>
</div>
