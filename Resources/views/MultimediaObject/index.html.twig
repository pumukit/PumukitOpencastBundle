<tr>
    <td><ul><li></li></ul></td>
    {% if not is_naked() %}
        <td>
            <a title="{% trans %}File info of multimedia object{% endtrans %} {{ mm.id }}"
               data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal"
               href="{{ path('pumukit_opencast_mm_info', {'id': mm.id}) }}">
                <i class="fa-solid fa-circle-info"></i>
            </a>
        </td>
    {% endif %}
    <td></td>
    <td>
        <a title="{% trans %}Edit Opencast file of multimedia object{% endtrans %} {{ mm.id }}"
           data-bs-toggle="modal" data-bs-backdrop="static" data-bs-target="#myModal"
           href="{{ path('pumukit_opencast_mm_update', {'id': mm.id}) }}">
            <i class="fa-solid fa-pencil"></i>
        </a>
    </td>
    {% if track %}
        {% include '@PumukitNewAdmin/Media/Type/Resources/_thumbnail_generator.html.twig' %}
    {% else %}
        <td></td>
    {% endif %}
    <td></td>
    <td>
        {% if generate_sbs %}
            <div class="dropdown dropup">
                <i class="fa-solid fa-arrows-rotate pmk-cursor-pointer" id="opencast_profiles_{{ mm.id }}" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"></i>
                <ul class="dropdown-menu" role="menu" aria-labelledby="opencast_profiles_{{ mm.id }}">
                    <li>&nbsp;&nbsp;<strong>{% trans %}Transcode to profile{% endtrans %}:</strong></li>
                    <li>
                        <a class="dropdown-item" href="#" data-action="click->admin--actions#load"
                           data-admin--actions-url-param="{{ path('pumukit_opencast_mm_generatesbs', {'id': mm.id}) }}"
                           data-admin--actions-data-param="{{ {'_method': 'POST'}|json_encode }}"
                           data-admin--actions-target-param="#tracks_mms_{{ mm.id }}">
                            <i class="fa-solid fa-film"></i> {{ sbs_profile }}
                        </a>
                    </li>
                    <li class="cancel"><a class="dropdown-item" href="#" data-action="click->admin--actions#cancel"><strong>{% trans %}Cancel{% endtrans %}...</strong></a></li>
                </ul>
            </div>
        {% endif %}
    </td>
    <td>
        &nbsp;{% if not is_naked() %}{{ mm.id }} - {% endif %}<strong>{% trans %}Opencast Recording{% endtrans %}</strong>
        &nbsp;<a target="_blank" rel="noopener" href="{{ player }}?id={{ mm.getProperty('opencast') }}{{ mm.getProperty('opencastinvert') ? '&display=invert' : '' }}">{{ mm.getProperty('opencast') }}</a>
        {% if mm.getProperty('opencastlanguage') %}
            <span class="badge text-bg-secondary">{{ mm.getProperty('opencastlanguage')|language_name }}</span>
        {% endif %}
    </td>
</tr>
