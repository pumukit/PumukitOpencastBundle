<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{% trans %}update Opencast track of Multimedia Object{% endtrans %}</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{% trans %}Close{% endtrans %}"></button>
</div>
<div class="modal-body">
    {% form_theme form '@PumukitNewAdmin/Themes/fields.html.twig' %}
    {{ form_start(form, {attr: {
        'data-controller': 'admin--modal-form',
        'data-action': 'submit->admin--modal-form#submit',
        'data-admin--modal-form-refresh-value': [{target: '#tracks_mms_' ~ mm.id, url: path('pumukitnewadmin_track_list', {'id': mm.id})}]|json_encode,
        'data-admin--modal-form-success-message-value': 'Track successfully updated.'|trans,
        'data-admin--modal-form-error-message-value': 'Error'|trans
    }}) }}
        <fieldset>
            <legend hidden>{% trans %}update Opencast track of Multimedia Object{% endtrans %}</legend>
            {{ form_rest(form) }}
        </fieldset>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Cancel{% endtrans %}</button>
            <button type="submit" class="btn btn-pumukit">{% trans %}OK{% endtrans %}</button>
        </div>
    {{ form_end(form) }}
</div>
